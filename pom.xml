<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Подключаю родительский проект Spring Boot (задает правильные версии всех библиотек) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>

    <groupId>com.credit-bank</groupId>
    <artifactId>deposit-calculator-fullstack</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>deposit-calculator-fullstack</name>

    <properties>
        <!-- версия Java 20 -->
        <maven.compiler.source>20</maven.compiler.source>
        <maven.compiler.target>20</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--библиотека для создания REST-контроллеров, обработки JSON и автоматически запускает встроенный веб-сервер Tomcat на порту 8080 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--подключаю движок Hibernate Validator. Зависимость для валидации данных (@Min, @Max, @NotNull) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Зависимость для встроенного сервера тестирования (автоматически идет со Spring Boot) -->
        <!--библиотека для написания тестов (JUnit, Mockito)-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <!--говорит о том, что этот код нужен только во время тестирования и не попадет в финальную сборку-->
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--Зачем нужен: Стандартный Java-проект компилируется в обычный jar, который нельзя запустить двойным кликом, потому что в нем нет встроенных зависимостей-->
    <!--Что делает плагин: spring-boot-maven-plugin при сборке упаковывает скомпилированный код, все скачанные библиотеки и сервер Tomcat в один толстый JAR файл. Его можно запустить на любом сервере одной командой java -jar app.jar.-->
    <build>
        <plugins>
            <!-- Плагин для сборки Spring Boot приложения в запускаемый JAR-файл -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>